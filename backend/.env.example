# =============================================================
# MinLish Backend - Environment Variables Example
# =============================================================

# Database - MySQL 8.0+
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:root@localhost:3306/minlish"

# JWT Configuration
JWT_SECRET="minlish-super-secret-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="minlish-refresh-secret-change-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# App
PORT=3000
NODE_ENV=development

# Google Sign-In Verification
GOOGLE_CLIENT_ID="your-google-client-id-here.apps.googleusercontent.com"
ENABLE_MOCK_GOOGLE_LOGIN=false

