                  "raw": "{{baseUrl}}/learning/due?deckId={{systemDeckId}}&limit=10",
                  "host": ["{{baseUrl}}"],
                  "path": ["learning", "due"],
                  "query": [
                    { "key": "deckId", "value": "{{systemDeckId}}" },
                    { "key": "limit", "value": "10" }
                  ]
                },
                "description": "Kiểm tra filter due cards qua `vocabularies.deck_id`, không có `deck_id` trong `review_cards`."
              },
              "response": []
            },
            {
              "name": "B4.6 Submit review (GOOD)",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "pm.collectionVariables.set('reviewedAtIso', new Date().toISOString());"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"vocabularyId\": \"{{systemVocabularyId}}\",\n  \"rating\": \"GOOD\",\n  \"reviewedAt\": \"{{reviewedAtIso}}\"\n}",
                  "options": {
                    "raw": { "language": "json" }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/learning/review",
                  "host": ["{{baseUrl}}"],
                  "path": ["learning", "review"]
                },
                "description": "Submit 1 kết quả review flashcard. Backend sẽ map `GOOD -> quality 4`, tính SM-2, update `review_cards`, insert `review_logs`, update `daily_activities`."
              },
              "response": []
            },
            {
              "name": "B4.7 Get review history (system vocabulary)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/learning/history?vocabularyId={{systemVocabularyId}}&limit=10",
                  "host": ["{{baseUrl}}"],
