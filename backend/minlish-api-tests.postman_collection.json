    {
      "name": "Dev B - Content (run after Login)",
      "description": "Luồng test Dev B: chạy **Step 1 - Login** trước (lưu accessToken), sau đó chạy lần lượt Decks → Vocabularies → Favorites → Imports.\n\nBiến seed mặc định (sau db:seed): systemDeckId, systemVocabularyId, levelId.",
      "item": [
        {
          "name": "Step 1 - Auth",
          "item": [
            {
              "name": "B0.1 Login (required – saves accessToken)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Login success', function () {",
                      "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                      "});",
                      "if (pm.response.code === 200 || pm.response.code === 201) {",
                      "    var jsonData = pm.response.json();",
                      "    if (jsonData.accessToken) {",
                      "        pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                      "    }",
                      "    if (jsonData.refreshToken) {",
                      "        pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                      "    }",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"tester@example.com\",\n  \"password\": \"Password123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["auth", "login"]
                },
                "description": "Chạy request này trước khi test Dev B. Dùng cùng user đã Register (Auth > 1.1) hoặc đổi email/password."
              },
              "response": []
            },
            {
              "name": "B0.2 Verify token (GET /users/me)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/users/me",
                  "host": ["{{baseUrl}}"],
                  "path": ["users", "me"]
                },
                "description": "Xác nhận accessToken hợp lệ trước khi gọi API Dev B."
              },
              "response": []
            }
          ]
        },
