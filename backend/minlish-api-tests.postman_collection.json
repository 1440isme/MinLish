        {
          "name": "Step 4 - Learning (Flashcard / SM-2)",
          "description": "Flow test cho module learning. Dùng `systemDeckId` và `systemVocabularyId` từ seed để tránh phụ thuộc vào vocabulary user vừa tạo/xóa ở Step 3.",
          "item": [
            {
              "name": "B4.1 Start learning deck (system deck)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200 || pm.response.code === 201) {",
                      "    var json = pm.response.json();",
                      "    if (json.newWords && json.newWords.length > 0 && json.newWords[0].id) {",
                      "        pm.collectionVariables.set('learningVocabularyId', json.newWords[0].id);",
                      "    }",
                      "    if ((!pm.collectionVariables.get('learningVocabularyId')) && json.dueCards && json.dueCards.length > 0 && json.dueCards[0].vocabularyId) {",
                      "        pm.collectionVariables.set('learningVocabularyId', json.dueCards[0].vocabularyId);",
                      "    }",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/learning/decks/{{systemDeckId}}/start?limitNewWords=5",
                  "host": ["{{baseUrl}}"],
                  "path": ["learning", "decks", "{{systemDeckId}}", "start"],
                  "query": [
                    { "key": "limitNewWords", "value": "5" }
                  ]
                },
                "description": "Khởi tạo flow học flashcard cho 1 deck. Response gồm `dueCards` và `newWords`."
              },
              "response": []
            },
            {
              "name": "B4.2 Get daily plan (system deck)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/learning/daily-plan?deckId={{systemDeckId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["learning", "daily-plan"],
                  "query": [
                    { "key": "deckId", "value": "{{systemDeckId}}" }
                  ]
                },
                "description": "Lấy daily plan cho deck cụ thể. Kiểm tra `newWordsGoal`, `newWordsAvailable`, `dueReviewCount`, `dueCards`, `newWords`."
              },
              "response": []
            },
            {
              "name": "B4.3 Start learning vocabulary (system vocabulary)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200 || pm.response.code === 201) {",
                      "    var json = pm.response.json();",
                      "    if (json.id) {",
                      "        pm.collectionVariables.set('reviewCardId', json.id);",
                      "    }",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/learning/vocabularies/{{systemVocabularyId}}/start",
                  "host": ["{{baseUrl}}"],
                  "path": ["learning", "vocabularies", "{{systemVocabularyId}}", "start"]
                },
                "description": "Find-or-create `review_card` cho `user_id + vocabulary_id`. Lần đầu sẽ tạo card mặc định với `status=NEW`, `dueAt=now`."
              },
              "response": []
            },
            {
              "name": "B4.4 Get due cards (global)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/learning/due?limit=10",
                  "host": ["{{baseUrl}}"],
                  "path": ["learning", "due"],
                  "query": [
                    { "key": "limit", "value": "10" }
                  ]
                },
                "description": "Sau khi start vocabulary, card mới tạo có `due_at <= now` nên sẽ xuất hiện trong danh sách due toàn cục."
              },
              "response": []
            },
            {
              "name": "B4.5 Get due cards by deck (system deck)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "type": "text"
                  }
